# -*- coding: utf-8 -*-
"""
COMET-RIOBAMBA - Model Cascade resiliente
- Local-first con soporte real para fallback
- Retries con backoff
- Circuit breaker simple por proveedor
- Sin dependencias externas nuevas
"""

import asyncio
import logging
import os
import time
from dataclasses import dataclass, field
from typing import Any, Optional, List, Dict

import requests

logger = logging.getLogger("services.model_cascade")


@dataclass
class ProviderConfig:
    name: str
    url: str
    model: str
    api_key: str = ""
    timeout: int = 120
    max_retries: int = 2
    cooldown_seconds: int = 60
    failure_threshold: int = 3
    extra_headers: Dict[str, str] = field(default_factory=dict)
    enabled: bool = True


@dataclass
class ProviderState:
    consecutive_failures: int = 0
    circuit_open_until: float = 0.0
    last_error: str = ""
    last_latency_ms: int = 0
    last_success_ts: float = 0.0


class ModelCascade:
    def __init__(self, agent: Optional[Any] = None):
        self.agent = agent
        self.ollama_timeout = int(os.getenv("OLLAMA_TIMEOUT_SECONDS", "120"))
        self.default_retries = int(os.getenv("MODEL_CASCADE_RETRIES", "2"))
        self.default_cooldown = int(os.getenv("MODEL_CASCADE_COOLDOWN_SECONDS", "60"))
        self.default_failure_threshold = int(os.getenv("MODEL_CASCADE_FAILURE_THRESHOLD", "3"))

        self.providers: List[ProviderConfig] = []
        self.provider_state: Dict[str, ProviderState] = {}

        self._load_providers()
        self._init_state()

    TIER_MAPPING = {
        "opus": "tier_opus",
        "sonnet": "tier_sonnet",
        "haiku": "tier_haiku",
        "default": "ollama_local"
    }


    def _load_providers(self) -> None:
        ollama_url = os.getenv("OLLAMA_OPENAI_URL", "http://localhost:11434/v1/chat/completions")
        ollama_model = os.getenv("OLLAMA_MODEL", "qwen2.5:3b")

        self.providers.append(
            ProviderConfig(
                name="ollama_local",
                url=ollama_url,
                model=ollama_model,
                api_key="",
                timeout=self.ollama_timeout,
                max_retries=self.default_retries,
                cooldown_seconds=self.default_cooldown,
                failure_threshold=self.default_failure_threshold,
            )
        )

        # Cargar providers por tier desde variables de entorno
        for tier in ["opus", "sonnet", "haiku"]:
            tier_url = os.getenv(f"MODEL_TIER_{tier.upper()}_URL", "").strip()
            tier_model = os.getenv(f"MODEL_TIER_{tier.upper()}_MODEL", "").strip()
            tier_api_key = os.getenv(f"MODEL_TIER_{tier.upper()}_API_KEY", "").strip()
            if tier_url and tier_model:
                self.providers.append(
                    ProviderConfig(
                        name=f"tier_{tier}",
                        url=tier_url,
                        model=tier_model,
                        api_key=tier_api_key,
                        timeout=int(os.getenv(f"MODEL_TIER_{tier.upper()}_TIMEOUT_SECONDS", str(self.ollama_timeout))),
                        max_retries=self.default_retries,
                        cooldown_seconds=self.default_cooldown,
                        failure_threshold=self.default_failure_threshold,
                    )
                )

        # Compatibilidad legacy
        cloud_model = os.getenv("OLLAMA_CLOUD_MODEL", "").strip()
        if cloud_model:
            self.providers.append(
                ProviderConfig(
                    name="ollama_cloud",
                    url=ollama_url,
                    model=cloud_model,
                    api_key="",
                    timeout=int(os.getenv("OLLAMA_CLOUD_TIMEOUT_SECONDS", str(self.ollama_timeout))),
                    max_retries=self.default_retries,
                    cooldown_seconds=self.default_cooldown,
                    failure_threshold=self.default_failure_threshold,
                )
            )
    def _init_state(self) -> None:
        self.provider_state = {p.name: ProviderState() for p in self.providers}

    async def generate(
        self,
        prompt: str,
        system_prompt: Optional[str] = None,
        max_tokens: int = 512,
        temperature: float = 0.7,
        tier: str = "default",
        **kwargs,
    ) -> str:
        # === SELECCIÓN DE PROVIDER POR TIER ===
        provider_name = self.TIER_MAPPING.get(tier, "ollama_local")
        preferred = next((p for p in self.providers if p.name == provider_name and p.enabled), None)
        if preferred:
            ordered_providers = [preferred] + [p for p in self.providers if p.name != provider_name]
        else:
            ordered_providers = [p for p in self.providers if p.enabled]

        if system_prompt is None and "systemprompt" in kwargs:
            system_prompt = kwargs.pop("systemprompt")
        if "maxtokens" in kwargs and not kwargs.get("max_tokens"):
            max_tokens = kwargs.pop("maxtokens")
        if "temp" in kwargs and not kwargs.get("temperature"):
            temperature = kwargs.pop("temp")

        messages = self._build_messages(prompt=prompt, system_prompt=system_prompt)
        last_error: Optional[Exception] = None
        attempted: List[str] = []

        for provider in ordered_providers:
            if not provider.enabled:
                continue

            if self._is_circuit_open(provider):
                state = self.provider_state[provider.name]
                logger.warning(
                    f"⏭️ Saltando '{
        # Seleccionar provider según tier
        provider_name = self.TIER_MAPPING.get(tier, "ollama_local")
        preferred_provider = next((p for p in self.providers if p.name == provider_name), None)
        
        # Si el provider preferido no está disponible, usar el primero disponible
        if preferred_provider and preferred_provider.enabled:
            # Reordenar para priorizar el provider del tier
            ordered_providers = [preferred_provider] + [p for p in self.providers if p.name != provider_name]
        else:
            ordered_providers = self.providers
        provider.name}' ({provider.model}) por circuit breaker "
                    f"hasta {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(state.circuit_open_until))}"
                )
                continue

            attempted.append(f"{provider.name}:{provider.model}")

            try:
                logger.info(f"🔄 ModelCascade: intentando '{provider.name}' ({provider.model})...")
                result = await self._call_with_retries(
                    provider=provider,
                    messages=messages,
                    max_tokens=max_tokens,
                    temperature=temperature,
                )
                if result and result.strip():
                    self._record_success(provider)
                    logger.info(f"✅ ModelCascade: éxito con '{provider.name}' ({provider.model})")
                    return result.strip()

                raise RuntimeError(f"Respuesta vacía desde {provider.name}:{provider.model}")

            except Exception as e:
                last_error = e
                self._record_failure(provider, e)
                logger.warning(
                    f"⚠️ ModelCascade: fallo en '{provider.name}' ({provider.model}): {e}. "
                    f"Probando siguiente proveedor..."
                )
                continue

        raise RuntimeError(
            f"🔴 Todos los proveedores fallaron. Intentados: {attempted}. Último error: {last_error}"
        )

    def _build_messages(self, prompt: str, system_prompt: Optional[str]) -> List[Dict[str, str]]:
        messages: List[Dict[str, str]] = []
        if system_prompt:
            messages.append({"role": "system", "content": system_prompt})
        messages.append({"role": "user", "content": prompt})
        return messages

    async def _call_with_retries(
        self,
        provider: ProviderConfig,
        messages: List[Dict[str, str]],
        max_tokens: int,
        temperature: float,
    ) -> str:
        last_error: Optional[Exception] = None

        for attempt in range(provider.max_retries + 1):
            try:
                return await asyncio.to_thread(
                    self._call_provider_once,
                    provider,
                    messages,
                    max_tokens,
                    temperature,
                )
            except Exception as e:
                last_error = e

                if not self._should_retry(e):
                    logger.warning(
                        f"❌ Error no reintentable en '{provider.name}' ({provider.model}): {e}"
                    )
                    raise

                if attempt >= provider.max_retries:
                    logger.warning(
                        f"❌ Retries agotados en '{provider.name}' ({provider.model}). "
                        f"Intentos: {provider.max_retries + 1}"
                    )
                    raise

                backoff_seconds = 2 ** attempt
                logger.warning(
                    f"⏳ Retry {attempt + 1}/{provider.max_retries} para '{provider.name}' "
                    f"en {backoff_seconds}s por error: {e}"
                )
                await asyncio.sleep(backoff_seconds)

        raise RuntimeError(f"Fallo inesperado sin respuesta tras retries: {last_error}")

    def _call_provider_once(
        self,
        provider: ProviderConfig,
        messages: List[Dict[str, str]],
        max_tokens: int,
        temperature: float,
    ) -> str:
        headers = {"Content-Type": "application/json"}
        if provider.api_key:
            headers["Authorization"] = f"Bearer {provider.api_key}"
        headers.update(provider.extra_headers or {})

        payload = {
            "model": provider.model,
            "messages": messages,
            "stream": False,
            "temperature": float(temperature),
            "max_tokens": int(max_tokens),
        }

        start = time.time()
        response = requests.post(
            provider.url,
            headers=headers,
            json=payload,
            timeout=provider.timeout,
        )
        elapsed_ms = int((time.time() - start) * 1000)
        self.provider_state[provider.name].last_latency_ms = elapsed_ms

        try:
            response.raise_for_status()
        except requests.HTTPError as e:
            status_code = getattr(response, "status_code", None)
            body_preview = ""
            try:
                body_preview = response.text[:500]
            except Exception:
                pass
            raise RuntimeError(
                f"HTTP {status_code} desde {provider.name}:{provider.model} - {body_preview}"
            ) from e

        data = response.json()
        choices = data.get("choices") or []
        if not choices:
            raise RuntimeError(f"Respuesta sin choices desde {provider.name}:{provider.model}")

        message = choices[0].get("message") or {}
        content = message.get("content")

        if isinstance(content, str) and content.strip():
            return content

        if isinstance(content, list):
            text_parts = [
                item.get("text", "")
                for item in content
                if isinstance(item, dict) and item.get("type") == "text"
            ]
            joined = "".join(text_parts).strip()
            if joined:
                return joined

        raise RuntimeError(f"Respuesta sin content utilizable desde {provider.name}:{provider.model}")

    def _classify_http_error(self, error: Exception) -> str:
        """Clasifica el error HTTP para decidir acción."""
        error_str = str(error).lower()
        if "http 429" in error_str or "429" in error_str or "rate limit" in error_str:
            return "rate_limit"
        if any(code in error_str for code in ["http 401", "http 403", "http 400", "http 422"]):
            return "client"
        if any(code in error_str for code in ["http 500", "http 502", "http 503", "http 504"]):
            return "server"
        if any(err in error_str for err in ["timeout", "connection", "timed out"]):
            return "network"
        return "unknown"

    def _should_retry(self, error: Exception) -> bool:
        text = str(error).lower()

        retry_markers = [
            "timeout",
            "timed out",
            "connection aborted",
            "connection reset",
            "temporarily unavailable",
            "http 429",
            "http 500",
            "http 502",
            "http 503",
            "http 504",
        ]
        no_retry_markers = [
            "http 400",
            "http 401",
            "http 403",
            "respuesta sin choices",
            "respuesta sin content utilizable",
        ]

        if any(marker in text for marker in no_retry_markers):
            return False
        if any(marker in text for marker in retry_markers):
            return True

        if isinstance(error, (requests.Timeout, requests.ConnectionError)):
            return True

        return False

    def _is_circuit_open(self, provider: ProviderConfig) -> bool:
        state = self.provider_state[provider.name]
        return time.time() < state.circuit_open_until

    def _record_success(self, provider: ProviderConfig) -> None:
        state = self.provider_state[provider.name]
        state.consecutive_failures = 0
        state.circuit_open_until = 0.0
        state.last_error = ""
        state.last_success_ts = time.time()

    def _record_failure(self, provider: ProviderConfig, error: Exception) -> None:
        """Registra fallo con comportamiento diferenciado por tipo de error HTTP."""
        state = self._get_state(provider)
        error_type = self._classify_http_error(error)

        # Rate limit (429): NO contar para circuit breaker, solo log
        if error_type == "rate_limit":
            logger.warning(
                "⏳ Rate limit en '%s' - backoff sin abrir circuito",
                provider.name
            )
            state.last_error = str(error)
            return

        # Error de cliente (401/403/400): abrir circuito INMEDIATAMENTE
        if error_type == "client":
            logger.error(
                "🚫 Error de cliente en '%s': %s - circuito abierto 5 min",
                provider.name, error
            )
            state.consecutive_failures = provider.failure_threshold
            state.circuit_open_until = time.time() + 300
            state.circuit_open = True
            state.last_error = str(error)
            return

        # Errores de servidor/red/unknown: conteo normal
        state.consecutive_failures += 1
        state.last_error = str(error)
        logger.warning(
            "⚠️  Fallo en '%s' (%d/%d): %s",
            provider.name, state.consecutive_failures,
            provider.failure_threshold, error
        )

        if state.consecutive_failures >= provider.failure_threshold:
            state.circuit_open_until = time.time() + (
                provider.failure_timeout_seconds
                if hasattr(provider, "failure_timeout_seconds")
                else 300
            )
            state.circuit_open = True
            logger.error(
                "🛑 Circuito ABIERTO para '%s' hasta %s",
                provider.name,
                time.strftime("%H:%M:%S", time.localtime(state.circuit_open_until))
            )

    def get_provider_health(self) -> List[Dict[str, Any]]:
        result: List[Dict[str, Any]] = []
        now = time.time()

        for provider in ordered_providers:
            state = self.provider_state[provider.name]
            result.append(
                {
                    "name": provider.name,
                    "model": provider.model,
                    "enabled": provider.enabled,
                    "timeout": provider.timeout,
                    "max_retries": provider.max_retries,
                    "consecutive_failures": state.consecutive_failures,
                    "circuit_open": state.circuit_open_until > now,
                    "circuit_open_until": state.circuit_open_until,
                    "last_error": state.last_error,
                    "last_latency_ms": state.last_latency_ms,
                    "last_success_ts": state.last_success_ts,
                }
            )

        return result

# ============================================
# COMET-RIOBAMBA - Configuración Híbrida (EXAMPLE)
# Copia este archivo a .env y rellena tus claves reales.
# NUNCA subas .env con secretos reales al repositorio.
# ============================================

# --- Moltbook API ---
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1
MOLTBOOK_API_KEY=tu_clave_aqui

# --- Cadencia y Límites ---
AGENT_CYCLE_INTERVAL_SECONDS=300
AGENT_POSTS_PER_DAY=6
AGENT_MAX_POSTS_PER_DAY=6
AGENT_PHASE_B_INTERVAL_SECONDS=300
AGENT_MAX_FEED_REPLIES_PER_DAY=20
AGENT_MAX_COMMENTS_PER_DAY=15

# --- Fases ---
AGENT_PHASE_A_ENABLED=1
AGENT_PHASE_B_ENABLED=1
AGENT_PHASE_C_ENABLED=1
AGENT_COMMENTS_PER_POST=0
AGENT_MAX_COMMENTS_PER_POST=10
AGENT_MAX_COMMENT_REPLIES_PER_CYCLE=6

# --- Outbox ---
AGENT_MAX_OUTBOX_POSTS_FOR_PHASE_A=5

# --- Whisper Mode ---
AGENT_WHISPER_MODE=0

# --- TIERS DE MODELO ---
DASHSCOPE_API_KEY=tu_clave_aqui

# --- Anthropic Claude 3.5 Sonnet = primario (tier_opus) ---
ANTHROPIC_API_KEY=tu_clave_aqui
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_TIMEOUT_SECONDS=120

# --- DeepSeek (fallback tras Anthropic, mapeado a tier_haiku) ---
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=tu_clave_aqui
DEEPSEEK_TIMEOUT_SECONDS=90

# --- Tier OPUS (env-config, usado solo si falta ANTHROPIC_API_KEY) ---
MODEL_TIER_OPUS_URL=https://api.deepseek.com/v1/chat/completions
MODEL_TIER_OPUS_MODEL=deepseek-chat
MODEL_TIER_OPUS_API_KEY=tu_clave_aqui
MODEL_TIER_OPUS_TIMEOUT_SECONDS=90

MODEL_TIER_SONNET_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
MODEL_TIER_SONNET_MODEL=gemini-2.5-flash
MODEL_TIER_SONNET_API_KEY=tu_clave_aqui
MODEL_TIER_SONNET_TIMEOUT_SECONDS=120

MODEL_TIER_HAIKU_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
MODEL_TIER_HAIKU_MODEL=gemini-2.0-flash
MODEL_TIER_HAIKU_API_KEY=tu_clave_aqui
MODEL_TIER_HAIKU_TIMEOUT_SECONDS=30

# --- Groq (fallback ultrarrápido) ---
GROQ_API_KEY=tu_clave_aqui
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30

# --- OpenRouter (fallback gratuito) ---
MODEL_TIER_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
MODEL_TIER_OPENROUTER_MODEL=openai/gpt-oss-120b:free
MODEL_TIER_OPENROUTER_API_KEY=tu_clave_aqui
MODEL_TIER_OPENROUTER_TIMEOUT_SECONDS=60

# --- Cerebras ---
CEREBRAS_API_KEY=tu_clave_aqui
CEREBRAS_API_URL=https://api.cerebras.ai/v1/chat/completions
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_TIMEOUT_SECONDS=30

# --- Ollama Local (último recurso, desactivado por defecto) ---
OLLAMA_OPENAI_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
LOCAL_LLM_URL=http://localhost:11434

# --- Telegram ---
TELEGRAM_ALERTS_ENABLED=1
TELEGRAM_BOT_TOKEN=tu_clave_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui
TELEGRAM_DAILY_REPORT=1

# comet_repurposer — environment variables
#
# Copy this file to .env in your comet_riobamba project root
# (C:\comet-riobamba-v31\.env) and merge with the existing keys.

# ===========================================================================
# 1. LLM providers (already configured by comet_riobamba — leave as is)
# ===========================================================================
# MODEL_TIER_OPUS_API_KEY=...        # Gemini via Google AI
# MODEL_TIER_SONNET_API_KEY=...
# MODEL_TIER_HAIKU_API_KEY=...
# GROQ_API_KEY=...
# MODEL_TIER_OPENROUTER_API_KEY=...
# CEREBRAS_API_KEY=...

# Optional overrides per provider (defaults are sensible).
# MODEL_TIER_OPUS_API_KEY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL_TIER_OPUS_API_KEY_MODEL=gemini-2.5-pro
# GROQ_API_KEY_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY_MODEL=llama-3.3-70b-versatile
# MODEL_TIER_OPENROUTER_API_KEY_BASE_URL=https://openrouter.ai/api/v1
# MODEL_TIER_OPENROUTER_API_KEY_MODEL=openai/gpt-oss-120b:free
# CEREBRAS_API_KEY_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_API_KEY_MODEL=llama-3.3-70b

# OPENAI_API_KEY=...                # optional, prepended to cascade
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ===========================================================================
# 2. Repurposer settings (all optional, defaults shown)
# ===========================================================================
REPURPOSE_LANGUAGE=en
REPURPOSE_TEMPERATURE=0.7
REPURPOSE_MAX_TOKENS=1200
REPURPOSE_TIMEOUT=60
REPURPOSE_OUTPUT_ROOT=exports/social_repurpose
REPURPOSE_DEDUP_DB=data/repurpose_dedup.db
REPURPOSE_LOG=logs/repurpose.jsonl

# ---------------------------------------------------------------------------
# 2a. Semantic dedup (optional but recommended)
# ---------------------------------------------------------------------------
# By default, comet_repurposer uses a lexical TF-IDF mode that catches
# obvious duplicates without any API call (threshold 0.20). For better
# results, configure an OpenAI-compatible embeddings endpoint:
#
#   EMBEDDINGS_BASE_URL=https://api.openai.com/v1
#   EMBEDDINGS_API_KEY=sk-...
#   EMBEDDINGS_MODEL=text-embedding-3-small
#
# Alternatives that work too:
#   EMBEDDINGS_BASE_URL=http://localhost:11434/v1   # local Ollama
#   EMBEDDINGS_MODEL=nomic-embed-text
#
# When embeddings are configured, the threshold auto-raises to 0.85
# (cosine similarity in dense vector space).
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# ===========================================================================
# 3. Publisher settings (LinkedIn + X/Twitter MVP)
# ===========================================================================
PUBLISH_QUEUE_DB=data/publish_queue.db
PUBLISH_KILL_SWITCH=data/KILL_SWITCH
PUBLISH_DRY_RUN_DEFAULT=1           # 1 = always dry-run unless --for-real --i-know
PUBLISH_MIN_GAP_HOURS=2             # min hours between two posts on same platform

# Optimal posting slots (UTC). Edit to match your audience timezone.
LINKEDIN_OPTIMAL_SLOTS=09:00,12:00,17:00
X_OPTIMAL_SLOTS=08:00,12:00,18:00,21:00

# ---------------------------------------------------------------------------
# 3a. LinkedIn credentials (obtain via `python -m comet_repurposer auth-linkedin`)
# ---------------------------------------------------------------------------
# Step 1: create app at https://www.linkedin.com/developers/apps/new
#         Add product: "Marketing API" (gives w_member_social scope)
#         Add redirect URI: http://localhost:8080/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Step 2: run `python -m comet_repurposer auth-linkedin` — the OAuth flow
#         will print these next values; paste them here.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN_EXPIRES_AT=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_REFRESH_TOKEN_EXPIRES_AT=
LINKEDIN_PERSON_ID=

# ---------------------------------------------------------------------------
# 3b. X / Twitter credentials (obtain at https://developer.x.com/en/portal/dashboard)
# ---------------------------------------------------------------------------
# Step 1: create a Project + App
# Step 2: set App permissions to "Read and Write"
# Step 3: generate Keys and Tokens (Consumer Keys + Authentication Tokens)
TWITTER_API_KEY=
TWITTER_API_KEY_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=               # optional, only needed for read endpoints
